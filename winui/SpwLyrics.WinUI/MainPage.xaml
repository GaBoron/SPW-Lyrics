<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SpwLyrics_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SpwLyrics_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="手动歌词搜索" />
            <TextBlock x:Name="TrackSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索关键词" KeyDown="SearchBox_KeyDown" PlaceholderText="输入歌曲名、艺术家或专辑" />
            <ComboBox x:Name="SourceBox" Grid.Column="1" AutomationProperties.Name="歌词来源" DisplayMemberPath="Name" />
            <Button x:Name="SearchButton" Grid.Column="2" Click="SearchButton_Click" Content="搜索" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CandidatePane.(Grid.RowSpan)" Value="2" />
                            <Setter Target="CandidatePane.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="PreviewPane.(Grid.Row)" Value="0" />
                            <Setter Target="PreviewPane.(Grid.Column)" Value="1" />
                            <Setter Target="PreviewPane.(Grid.RowSpan)" Value="2" />
                            <Setter Target="PreviewPane.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="CandidatePane" Grid.ColumnSpan="2" Padding="1" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ListView x:Name="CandidateList" AutomationProperties.Name="歌词候选" IsItemClickEnabled="True" SelectionChanged="CandidateList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Artists}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Album}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Quality}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Duration}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding ScoreText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyResults" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="输入关键词开始搜索" />
                </Grid>
            </Border>

            <Border x:Name="PreviewPane" Grid.Row="1" Grid.ColumnSpan="2" Padding="18,12" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="歌词预览" />
                    <ListView x:Name="PreviewList" Grid.Row="1" AutomationProperties.Name="歌词预览" IsItemClickEnabled="False" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,7" Spacing="3">
                                    <TextBlock FontSize="17" Text="{Binding Main}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Secondary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="LocalButton" Click="LocalButton_Click" Content="切回本地歌词" />
                        <Button x:Name="ApplyButton" Click="ApplyButton_Click" Content="应用此歌词" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" />
            <ProgressRing x:Name="BusyRing" Width="24" Height="24" HorizontalAlignment="Right" IsActive="False" />
        </Grid>
    </Grid>
</Page>
