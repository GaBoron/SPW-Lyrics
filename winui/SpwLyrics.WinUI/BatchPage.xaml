<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SpwLyrics_WinUI.BatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SpwLyrics_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="批量处理音乐库" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="提前为 SPW 音乐库搜索并缓存歌词，之后首次播放也能直接应用。" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已选择 / 音乐库" /><TextBlock x:Name="TotalText" FontSize="22" FontWeight="SemiBold" Text="—" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已处理" /><TextBlock x:Name="ProcessedText" FontSize="22" FontWeight="SemiBold" Text="—" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="新缓存" /><TextBlock x:Name="CompletedText" FontSize="22" FontWeight="SemiBold" Text="—" /></StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已有缓存" /><TextBlock x:Name="CachedText" FontSize="22" FontWeight="SemiBold" Text="—" /></StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="需重试" /><TextBlock x:Name="FailedText" FontSize="22" FontWeight="SemiBold" Text="—" /></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Click="StartButton_Click" Content="开始处理" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="PauseButton" Grid.Column="1" Click="PauseButton_Click" Content="暂停" IsEnabled="False" />
            <Button x:Name="RetryButton" Grid.Column="2" Click="RetryButton_Click" Content="重试失败项" IsEnabled="False" />
            <Button x:Name="CancelButton" Grid.Column="3" Click="CancelButton_Click" Content="停止" IsEnabled="False" />
            <CheckBox x:Name="IncludeCachedCheckBox" Grid.Column="4" HorizontalAlignment="Right" Content="重新处理已有缓存" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressBar x:Name="OverallProgress" Height="4" VerticalAlignment="Center" />
            <TextBlock x:Name="OverallProgressText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0%" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="ActiveRing" Width="16" Height="16" IsActive="False" />
                <TextBlock x:Name="StateText" VerticalAlignment="Center" FontWeight="SemiBold" Text="正在读取音乐库…" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="12,9" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="105" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAllCheckBox" AutomationProperties.Name="全选或取消全选歌曲" Click="SelectAllCheckBox_Click" IsThreeState="True" />
                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="歌曲" />
                    <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" />
                    <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前阶段" />
                    <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="结果" />
                </Grid>
                <ListView x:Name="TrackList" Grid.Row="1" AutomationProperties.Name="批量处理状态列表">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BatchItemViewModel">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="105" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                <CheckBox AutomationProperties.Name="选择此歌曲" Click="ItemSelection_Click" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6"><FontIcon FontSize="12" Glyph="{x:Bind StatusGlyph, Mode=OneWay}" /><TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" /></StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Stage, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Height="3" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Result, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon FontSize="30" Glyph="&#xE8B7;" />
                    <TextBlock FontWeight="SemiBold" Text="没有读到可处理的歌曲" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="请先在 SPW 中完成音乐库扫描，再重新打开此页。" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="5" IsClosable="True" IsOpen="False" />
    </Grid>
</Page>
