<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpwLyrics_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SpwLyrics_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SPW Lyrics"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ManualItem" Content="手动搜索" Tag="manual">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="BatchItem" Content="批量处理" Tag="batch">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="RootFrame" />
    </NavigationView>
</Window>
