{
  "configs": [
    {
      "title": "SPW Lyrics",
      "config": "spw-lyrics.json",
      "preferences": [
        {
          "key": "automatic_replacement_policy",
          "type": "list",
          "title": "自动替换歌词",
          "summary": "控制插件何时搜索并替换 SPW 本地歌词",
          "entries": ["始终优先使用插件歌词", "仅在本地无歌词时补充", "仅手动选择时替换"],
          "entry_values": ["always", "when_local_missing", "manual_only"],
          "default_value": "always"
        },
        {
          "key": "manual_search_shortcut_enabled",
          "type": "switch",
          "title": "通过快捷键开启",
          "summary": "在 SPW 前台按 Ctrl+Shift+M 打开手动搜索歌词",
          "default_value": true
        },
        {
          "type": "button",
          "title": "查看本地缓存文件夹",
          "summary": "在文件资源管理器中打开已缓存的歌词",
          "arrow_type": "none",
          "on_click": "dev.gaboron.spwlyrics.integration.SpwLyricsActions.openCacheFolder"
        }
      ]
    }
  ]
}
